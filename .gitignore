node_modules/
*.log
.DS_Store
*.tgz

# Release folder produced by scripts/build-distribution.mjs (tarballs + generated
# profile). Publish it as GitHub Release assets; it is never committed.
/dist/

# Desktop shell build output (the published shell is copied into dist/).
/desktop/DshSuite.Shell/bin/
/desktop/DshSuite.Shell/obj/

# Local preview screenshots (site/architecture rendered for review, never shipped).
/.preview/

# Generated by `dsh` when a profile directory is booted:
# cordis.yml is the empty root-include stub, .plugin-manager holds manager state.
# Both are rebuilt from package.json + cordis.patch.yml — never hand-edited.
profile/*/cordis.yml
profile/*/.plugin-manager/

# Generated by `create_engineering_project` when this repository is used as a DSH
# workspace (see docs/roadmap.md §4 and packages/dsh-engineering-context):
#   tia/                the TIA project TIA itself saved here — binary, and edited
#                       in TIA Portal rather than here, so it is never versioned.
#   knowledge/**/*.db*  the per-device knowledge databases rebuilt from source/ —
#                       binary, hundreds of MB on a real project, and regenerated
#                       on every run; the trailing * also covers SQLite's own
#                       -wal / -shm / -journal side files.
# The rebuilt source tree in source/ is the text artifact that belongs in git.
# /tia/ is anchored to the workspace root for the same reason as /hardware/
# below: the tool defaults there and nowhere else. An unanchored `tia/` would
# also swallow site/assets/images/tia/ (TIA Portal screenshots used by the site).
/tia/
knowledge/**/*.db*

# Generated by `export_hardware_config` (packages/dsh-tia-openness-v17-min, v0.3):
#   /hardware/          the CAx/AML export of the open project's hardware
#                       configuration — globalHardware.aml plus TIA's own
#                       globalHardware.log. Anchored to the workspace root on
#                       purpose: the tool defaults there and nowhere else.
# Ignored for now, not forever: how this artifact should be tracked (revisions
# per export, diffing the AML, or only a hash) is still undecided, and the AML
# embeds timestamps, so two exports of an unchanged project differ byte-wise.
# Decide before committing one — see
# packages/dsh-tia-openness-v17-min/docs/HARDWARE-CONFIG-SCOPE.md §3 (U9).
/hardware/

# Generated by dsh-file-claim while sessions run in parallel (see AGENTS.md §8):
#   <path>.dshclaim             claim sidecar next to every claimed path — holder,
#                               heartbeat, note; rewritten on every claim/release.
#   <path>.dshpending/          async pending-merge entry (edited content + git HEAD
#                               base) for a path waiting on another session.
#   .dsh-file-claim.audit.jsonl append-only audit at the workspace root (one JSON line
#                               per claim / release / takeover / pending mutation).
#   .dsh-file-claim.lock        transient cross-process mutex; stale only after a crash.
# All four are plugin-owned state: never commit them, never hand-delete the audit.
*.dshclaim
*.dshpending
.dsh-file-claim.audit.jsonl
.dsh-file-claim.lock

# PLCSIM Advanced snapshots (dsh-plcsim-advanced): local instance archives, not sources.
.dsh/simulation/

# Ad-hoc scratch work (derived scripts, intermediate dumps) that agents create
# while investigating a workspace. Never a deliverable: disposable by definition,
# so it stays out of git. Deliverable reports go to the workspace root instead.
/temp/
# Electrical drawings ingested by the drawing plugin (packages/dsh-drawing):
#   drawing/<name>.pdf   the copy made at ingest — a large binary whose source of
#                        truth is wherever the user keeps it
#   drawing/<name>/      the derived index (sheets/xrefs/names/profile), rebuilt
#                        from the PDF in about three seconds
# Both are derived state; a project that wants a drawing under version control
# can opt in with a negation rule for the specific file.
/drawing/
# Generated by dsh-engineering-context's project_translate: exported XLSX, jobs,
# translations, reports and the pre-import archive. Derived state, never source.
/translations/
