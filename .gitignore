node_modules/
*.log
.DS_Store
*.tgz

# Generated by `dsh` when a profile directory is booted:
# cordis.yml is the empty root-include stub, .plugin-manager holds manager state.
# Both are rebuilt from package.json + cordis.patch.yml — never hand-edited.
profile/*/cordis.yml
profile/*/.plugin-manager/

# Generated by `create_engineering_project` when this repository is used as a DSH
# workspace (see docs/roadmap.md §4 and packages/dsh-engineering-context):
#   tia/                the TIA project TIA itself saved here — binary, and edited
#                       in TIA Portal rather than here, so it is never versioned.
#   knowledge/**/*.db*  the per-device knowledge databases rebuilt from source/ —
#                       binary, hundreds of MB on a real project, and regenerated
#                       on every run; the trailing * also covers SQLite's own
#                       -wal / -shm / -journal side files.
# The rebuilt source tree in source/ is the text artifact that belongs in git.
tia/
knowledge/**/*.db*
