    "@voltarenyah/dsh-plcsim-advanced": "workspace:^",
    "@voltarenyah/dsh-tia-openness-v17-min": "workspace:^",
    "@voltarenyah/dsh-tia-todo-bridge": "workspace:^",
    "dsh-opencode-go": "0.1.24",
    "dsh-tool-git": "workspace:^",
    "dsh-ui-plc-source": "workspace:^",
    "dsh-ui-tia-console": "workspace:^",
    "dsh-ui-versions": "workspace:^",
    "dsh-ui-changes": "workspace:^",
    "dsh-ui-hardware": "workspace:^",
    "dsh-ui-prompt-guide": "workspace:^",
    "dsh-ui-project-dashboard": "workspace:^"
  },
  "dsh": {
