{
  "name": "dsh-profile-dsh-automation-suite",
  "version": "0.1.0",
  "private": true,
  "description": "DSH profile blueprint for the dsh-automation-suite distribution: the shipped Web composition plus this suite's plugins.",
  "dependencies": {
    "@voltarenyah/dsh-engineering-context": "workspace:^",
    "@voltarenyah/dsh-engineering-graph": "workspace:^",
    "@voltarenyah/dsh-tia-openness-v17-min": "workspace:^",
    "dsh-opencode-go": "0.1.15",
    "dsh-tool-git": "workspace:^",
    "dsh-ui-plc-source": "workspace:^",
    "dsh-ui-tia-console": "workspace:^"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@voltarenyah/dsh-tia-openness-v17-min",
        "@voltarenyah/dsh-engineering-context",
        "@voltarenyah/dsh-engineering-graph",
        "dsh-tool-git",
        "dsh-ui-plc-source",
        "dsh-ui-tia-console",
        "dsh-opencode-go"
      ]
    }
  }
}
