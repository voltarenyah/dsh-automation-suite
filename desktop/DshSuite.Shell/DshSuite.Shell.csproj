<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DshSuite.Shell</AssemblyName>
    <RootNamespace>DshSuite.Shell</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Keep `dotnet build` self-contained too. A framework-dependent build
         output makes a double-click show the .NET install prompt, which is not
         the shipped shape and caused a false alarm during Phase 1 testing. -->
    <SelfContained>true</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The WebView2 package carries both WinForms and WPF assemblies; the WPF
         reference's WindowsBase conflict is harmless for this WinForms app. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TitleBarScript.js" LogicalName="DshSuite.Shell.TitleBarScript.js" />
    <!-- Landing-hero branding (the former `@automation-suite/ui-brandmark`
         plugin). The script is injected at document creation; the mark travels
         with it as a data URL because the injected script has no asset route. -->
    <EmbeddedResource Include="BrandScript.js" LogicalName="DshSuite.Shell.BrandScript.js" />
    <EmbeddedResource Include="brandmark.png" LogicalName="DshSuite.Shell.brandmark.png" />
  </ItemGroup>

</Project>
