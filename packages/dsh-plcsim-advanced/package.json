{
  "name": "@voltarenyah/dsh-plcsim-advanced",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin: manage S7-PLCSIM Advanced instances and exchange PLC tags through the PLCSIM Advanced runtime API (API 4.0 baseline, Softbus by default).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./tools": {
      "default": "./lib/tools-entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "controller/bin",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plcsim-advanced",
    "simulation",
    "plc",
    "siemens"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:controller": "pwsh -NoProfile -File controller/build.ps1",
    "link:runtime": "node scripts/link-dsh-runtime.mjs",
    "test": "node --test --test-reporter=spec \"test/*.test.mjs\"",
    "test:controller": "controller/bin/PlcsimAdvanced.Controller.exe --self-test",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
