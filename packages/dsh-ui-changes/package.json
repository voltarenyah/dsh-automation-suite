{
  "name": "dsh-ui-changes",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin: a right-sidebar 'Changes' tab listing uncommitted files with per-file line counts, and a commit area that sends a fixed prompt into the current session (the commit itself stays with the agent's git tools).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "ui",
    "git",
    "changes",
    "sidebar"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
