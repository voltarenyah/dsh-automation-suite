# Keep line endings deterministic across the repository.
* text=auto

# Windows-only scripting and C# sources stay CRLF-friendly.
*.cs    text eol=crlf
*.csproj text eol=crlf
*.ps1   text eol=crlf
*.config text eol=crlf

# Everything else is authored with LF.
*.ts    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.cjs   text eol=lf
# Generated, byte-compared by scripts/coverage/build-matrix.mjs --check.
*.html  text eol=lf
# Vendored upstream skills and their license, byte-compared (sha256 + size) by
# scripts/knowledge/build-skills.mjs --check. Without an explicit `eol=lf` a
# `core.autocrlf=true` checkout rewrites the license to CRLF and the check fails
# on a fresh clone.
*.txt   text eol=lf

# Binaries are never normalized.
*.exe   binary
*.dll   binary
*.pdb   binary
