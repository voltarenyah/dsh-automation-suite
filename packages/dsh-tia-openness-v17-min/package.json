{
  "name": "@voltarenyah/dsh-tia-openness-v17-min",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin: minimal TIA Portal V17 Openness block read/write (export/import Simatic ML, compile, verified writes) through a whitelisted C# controller subprocess.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "controller/bin",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "tia-portal",
    "openness",
    "simatic-ml",
    "plc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:controller": "pwsh -NoProfile -File controller/build.ps1",
    "link:runtime": "node scripts/link-dsh-runtime.mjs",
    "matrix:extract": "node scripts/coverage/extract-sources.mjs",
    "matrix:build": "node scripts/coverage/build-matrix.mjs",
    "matrix:check": "node scripts/coverage/build-matrix.mjs --check",
    "test": "node --test --test-reporter=spec \"test/*.test.mjs\"",
    "test:controller": "controller/bin/TiaOpennessV17Min.Controller.exe --self-test",
    "check": "npm run build && npm test && npm run matrix:check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
