<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIAOpennessV17Min C# controller.

    Targets .NET Framework 4.8 / x64 because TIA Portal V17 Openness is a 64-bit
    .NET Framework API.

    The Siemens references come from Siemens' own NuGet packages instead of a
    hard-coded HintPath:

      * Siemens.Collaboration.Net.TiaPortal.Packages.Openness  (build time only)
        An MSBuild-only package. It locates the Siemens.Engineering assemblies via
        the TIA Portal registry entries, the TiaPortalLocation property or
        environment variable, and references every DLL of that PublicAPI folder
        with CopyLocal=false — so no Siemens binary is ever copied into the
        output. The package version mirrors the TIA Portal version: 17.0.x for
        V17, 21.0.x for V21. Bump it together with the target TIA Portal version.

      * Siemens.Collaboration.Net.TiaPortal.Openness.Resolver  (run time)
        Registers Siemens' own assembly resolver before the first Openness type
        is touched, and picks the Siemens.Engineering assembly that matches the
        version this app was built against. V2 is TIA Portal V21+ only, therefore
        a V17 controller pins the 1.1 line.

    The explicit OperatingSystem.Windows reference suppresses NU1603: the
    Resolver 1.1 declares a dependency version Siemens no longer publishes, so
    NuGet would otherwise resolve it with a "best match" warning.

    Building therefore needs a NuGet feed (nuget.org, or a mirror) and a local
    TIA Portal installation to reference the Openness assemblies from.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TiaOpennessV17Min.Controller</AssemblyName>
    <RootNamespace>TiaOpennessV17Min.Controller</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The TIA Portal version this controller is bound to. -->
    <TiaPortalMajorVersion Condition="'$(TiaPortalMajorVersion)' == ''">17</TiaPortalMajorVersion>
    <OpennessReferencePackageVersion Condition="'$(OpennessReferencePackageVersion)' == ''">17.0.1685432625</OpennessReferencePackageVersion>
    <OpennessResolverPackageVersion Condition="'$(OpennessResolverPackageVersion)' == ''">1.1.1725480302</OpennessResolverPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Packages.Openness" Version="$(OpennessReferencePackageVersion)" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Resolver" Version="$(OpennessResolverPackageVersion)" />
    <!-- Pinned so NuGet does not have to fall back to an approximate match (NU1603). -->
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
