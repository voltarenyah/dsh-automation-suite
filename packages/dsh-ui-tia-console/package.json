{
  "name": "dsh-ui-tia-console",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin: a TIA Portal console above the composer — live state (no project / opening / open / saving / compiling / closing), elapsed time for long operations, one-click open/save/compile/close through the existing /tia-* commands, and a refresh that re-syncs the state with the controller.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "tia",
    "siemens",
    "ui"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
