{
  "name": "@voltarenyah/dsh-engineering-graph",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin (family 3): engineering knowledge graph — the TypeScript half that will drive the vendored C# `engine/` over engineering artefacts (block logic, cross-references), with no dependency on TIA Portal.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "engine/bin",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "engineering-graph",
    "knowledge-graph",
    "plc"
  ],
  "scripts": {
    "build": "node scripts/tsc.mjs -p tsconfig.json",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "link:runtime": "node scripts/link-dsh-runtime.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
