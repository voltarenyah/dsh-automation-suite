{
  "name": "@voltarenyah/dsh-engineering-context",
  "version": "0.1.0",
  "private": false,
  "description": "DSH plugin: engineering project context — saves the project TIA Portal has open into the workspace and rebuilds its source tree, through the TIA interface plugin's service seam (it never talks to TIA Portal itself).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./diff": {
      "default": "./lib/diff-entry.js"
    },
    "./status": {
      "default": "./lib/status-entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "engineering-context",
    "workspace",
    "plc"
  ],
  "scripts": {
    "build": "node scripts/tsc.mjs -p tsconfig.json",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "link:runtime": "node scripts/link-dsh-runtime.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
